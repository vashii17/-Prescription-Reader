# Copy this file to .env and adjust. Every value has a working default.

# Ollama runs Gemma locally. The photo and medical details never leave this address.
OLLAMA_BASE_URL=http://localhost:11434
# Any multimodal Gemma tag. gemma4:e2b is the smallest; use gemma4:e4b or larger on a stronger machine.
GEMMA_MODEL=gemma4:e2b

# ElevenLabs text-to-speech. Leave the key empty to use the browser's built-in speech instead.
ELEVENLABS_API_KEY=
# A voice id from your ElevenLabs voice library.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

TEMPORAL_ADDRESS=localhost:7233

# 1 = one day passes in one minute (for demos). 0 = real time.
DEMO_MODE=0

# Optional webhook that receives a JSON POST when a dose is missed.
# If empty, missed doses only show in the caregiver view.
CAREGIVER_NOTIFY_URL=
